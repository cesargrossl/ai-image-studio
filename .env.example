# Altere esta senha ANTES de expor na rede. Não inclua espaços após o valor.
APP_ADMIN_USER=admin
APP_PASSWORD=troque-esta-senha
APP_PORT=8501
OLLAMA_MODEL=qwen2.5:3b

# Ajustes de desempenho e tamanho das imagens
MAX_IMAGE_MB=20
MAX_IMAGE_SIDE=3072
