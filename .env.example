# Serviços generativos opcionais (profile gpu / objects)
GEN_LOW_VRAM=0
GEN_MAX_SIDE=1024
SDXL_BASE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
SDXL_INPAINT_MODEL=diffusers/stable-diffusion-xl-1.0-inpainting-0.1
DINO_MODEL=IDEA-Research/grounding-dino-tiny
